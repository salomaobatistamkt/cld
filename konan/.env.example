# Copie para .env (ou cadastre estas variáveis no Coolify) e ajuste.

# Nome que acorda a assistente
KONAN_NOME=Konan

# Cérebro. Padrão: Qwen3 4B (~2,5 GB). Mais leve e rápido, porém menos esperto:
# MODELO=unsloth/Qwen3-1.7B-GGUF:Q4_K_M
MODELO=unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M
CONTEXTO=4096
THREADS=4

# Áudio: número da placa da caixa de som USB (veja com: aplay -l)
ALSA_CARD=0

# Ouvido: tiny (mais leve) | base (padrão) | small (mais preciso, mais pesado)
WHISPER_MODELO=base

# Voz: kokoro (feminina pt-BR "pf_dora") | piper (pt_BR-faber-medium, masculina)
VOZ_MOTOR=kokoro
VOZ_VELOCIDADE=1.0

# Interface estilo Jarvis (0 desliga)
INTERFACE_ATIVA=1
INTERFACE_PORTA=8090
# Endereço que ela fala quando você pede "abre sua interface"
INTERFACE_URL=http://192.168.0.10:8090

TZ=America/Sao_Paulo
