      "parameters": {
        "jsCode": "const cols = [\"Link do Relatório\", \"Enviar Relatório\", \"Relatório - Melhorias\", \"Relatório - Ajustes\"];\nconst out = [];\nfor (const it of $input.all()) {\n  const r = it.json || {};\n  const conta = String(r['ID da Conta'] ?? '').trim();\n  if (r.error || !conta) continue;\n  const j = { 'ID da Conta': conta };\n  for (const c of cols) j[c] = r[c] ?? '';          // mantém o que já estiver preenchido\n  out.push({ json: j });\n}\nreturn out;"
      },
