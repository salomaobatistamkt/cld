    {
      "parameters": {
        "jsCode": "const J = n => { try { return $(n).first().json || {}; } catch (e) { return null; } };\nconst err = j => j && j.error ? String(j.error.message || j.error.description || JSON.stringify(j.error)).slice(0, 200) : '';\nconst L = [];\nconst c = J('Planilha Geral › Clientes: criar colunas');\nL.push(c && !err(c) ? '✅ Planilha Geral › Clientes: colunas *Link do Relatório*, Enviar Relatório, Relatório - Melhorias e Relatório - Ajustes prontas' : '⚠️ Planilha Geral › Clientes: não consegui criar as colunas — ' + err(c));\nfor (const [rot, aba] of [[\"Planilha Geral\", \"Parâmetros\"], [\"Planilha Pausa\", \"Campanhas Pausadas\"], [\"Planilha Pausa\", \"Pausas CPR\"]]) {\n  const cr = J(`${rot} › criar aba ${aba}`), hd = J(`${rot} › ${aba}: escrever cabeçalhos`);\n  const e = err(cr);\n  if (!e) L.push(`✅ ${rot} › aba *${aba}* criada` + (hd && !err(hd) ? ' com os cabeçalhos' : ' (⚠️ cabeçalhos não gravados: ' + err(hd) + ')'));\n  else if (/exist/i.test(e)) L.push(`✔️ ${rot} › aba *${aba}* já existia (mantida)`);\n  else L.push(`⚠️ ${rot} › aba *${aba}*: ${e}`);\n}\nconst r = J('Planilha de Grupos › renomear aba para KONEXT');\nL.push(r && !err(r) ? '✅ Planilha de grupos › aba renomeada para *IDS GRUPOS - CLIENTES KONEXT*' : '⚠️ Planilha de grupos › não consegui renomear — ' + err(r));\nreturn [{ json: { mensagem: `🧱 *Planilhas Konext preparadas*\\n\\n${L.join('\\n')}\\n\\nAgora é só colar o link de cada cliente na coluna *Link do Relatório* (Planilha Geral › Clientes).` } }];"
      },
