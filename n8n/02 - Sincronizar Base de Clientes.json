    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const cl = $('Loop Clientes').item.json;\nconst pg = $('Páginas').item.json, ig = $('Instagram').item.json, sv = $('Salvos').item.json, cu = $input.item.json;\nconst norm = s => String(s ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().replace(/[^a-z0-9 ]/g, ' ').replace(/\\s+/g, ' ').trim();\nconst arr = x => Array.isArray(x.data) ? x.data : [];\nconst agora = $now.toFormat('yyyy-MM-dd HH:mm');\nconst obs = [];\nlet pagina = cl.pagina, ig_id = cl.ig_id, ig_user = cl.ig_user;\nconst pages = arr(pg), igs = arr(ig);\nif (pg.error) obs.push('Erro ao ler Páginas (sem acesso à conta?)');\nelse if (!pagina) {\n  if (pages.length === 1) pagina = String(pages[0].id);\n  else obs.push(pages.length ? 'Várias Páginas — cole o ID certo: ' + pages.map(x => `${x.name} (${x.id})`).join('; ') : 'Nenhuma Página vinculada à conta');\n}\nif (!ig.error && !ig_id) {\n  if (igs.length === 1) { ig_id = String(igs[0].id); ig_user = String(igs[0].username || ''); }\n  else obs.push(igs.length ? 'Vários Instagram — cole ID e usuário: ' + igs.map(x => `@${x.username} (${x.id})`).join('; ') : 'Nenhum Instagram vinculado (ok se não usar objetivo Tráfego)');\n}\nif (ig.error) obs.push('Erro ao ler Instagram da conta');\nif (sv.error) obs.push('Erro ao ler públicos salvos');\nif (cu.error) obs.push('Erro ao ler públicos personalizados');\nconst cat = name => {\n  const n = norm(name), t = new Set(n.split(' '));\n  if (n.startsWith('rmkt') || t.has('rmkt') || t.has('remarketing')) return 'RMKT';\n  const suf = t.has('mulheres') ? ' Mulheres' : t.has('homens') ? ' Homens' : '';\n  if (t.has('aberto')) return 'Aberto' + suf;\n  if ([...t].some(x => x.startsWith('comprador'))) return 'Compradores' + suf;\n  return 'Outro';\n};\nconst linha = (tipo, a) => ({ 'Cliente': cl.cliente, 'ID da Conta': cl.conta, 'Tipo': tipo, 'Nome no Meta': String(a.name ?? ''),\n  'ID do Público': String(a.id), 'Categoria (auto)': cat(a.name), 'Última sincronização': agora });\nconst publicos = [...arr(sv).map(a => linha('Salvo', a)), ...arr(cu).map(a => linha('Personalizado', a))];\nreturn { json: {\n  update: { row_number: cl.row_number, 'ID da Página': pagina || '', 'ID Instagram': ig_id || '', 'Instagram (usuário)': ig_user || '',\n            'Última sincronização': agora, 'Observações': obs.join(' | ') },\n  publicos } };"
      },
