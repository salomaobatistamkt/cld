    {
      "parameters": {
        "jsCode": "const n_ = s => String(s ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]/g, '');\nconst pick = (row, nomes) => { const m = {}; for (const k of Object.keys(row)) m[n_(k)] = row[k];\n  for (const nome of nomes) { const v = m[n_(nome)]; if (v !== undefined && String(v).trim() !== '') return String(v).trim(); } return ''; };\nconst dig = v => String(v ?? '').replace(/\\D/g, '');\nconst out = [];\nfor (const it of $input.all()) {\n  const r = it.json || {};\n  if (r.error || !r.row_number) continue;\n  if (n_(pick(r, ['Status'])) !== 'ativo') continue; // Status = Ativo\n  const conta = dig(pick(r, ['ID da Conta']));\n  const cliente = pick(r, ['Cliente']);\n  if (!conta || !cliente) continue;\n  out.push({ json: { row_number: r.row_number, cliente, conta, pagina: dig(pick(r, ['ID da Página'])),\n    ig_id: dig(pick(r, ['ID Instagram'])), ig_user: pick(r, ['Instagram (usuário)']).replace(/^@/, '') } });\n}\nreturn out;"
      },
